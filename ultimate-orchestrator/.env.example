# Ultimate Orchestrator Configuration
# ====================================
# Copy this file to .env and fill in your API keys

# ===================
# LLM Configuration
# ===================
LLM_PROVIDER=openai                          # Options: openai, anthropic, openrouter, groq, google
MODEL_CHOICE=gpt-4o                          # Model name (gpt-4o, claude-3-5-sonnet-20241022, etc.)
OPENAI_API_KEY=your-openai-api-key-here
BASE_URL=https://api.openai.com/v1           # API base URL
LLM_TEMPERATURE=0.7                          # Temperature (0.0 - 2.0)
LLM_MAX_TOKENS=4096                          # Max tokens per request
LLM_TIMEOUT=60                               # Timeout in seconds

# Alternative LLM Providers (Optional)
# ANTHROPIC_API_KEY=your-anthropic-key
# OPENROUTER_API_KEY=your-openrouter-key
# GROQ_API_KEY=your-groq-key
# GOOGLE_API_KEY=your-google-key

# ===================
# Database Configuration (Optional)
# ===================
DB_PROVIDER=supabase                         # Options: supabase, postgres, mongodb, pinecone, chromadb

# Supabase
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_CONNECTION_STRING=your-connection-string

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/
# MONGODB_DATABASE=your-database-name

# Vector Databases
# PINECONE_API_KEY=your-pinecone-key
# PINECONE_ENVIRONMENT=your-environment
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8000

# ===================
# Voice Configuration (Optional)
# ===================
# Speech-to-Text
STT_PROVIDER=deepgram                        # Options: deepgram, openai_whisper, assemblyai, azure_speech
DEEPGRAM_API_KEY=your-deepgram-key
# ASSEMBLYAI_API_KEY=your-assemblyai-key
# AZURE_SPEECH_KEY=your-azure-key
# AZURE_SPEECH_REGION=your-region

# Text-to-Speech
TTS_PROVIDER=openai                          # Options: openai, elevenlabs, cartesia, azure_speech
# ELEVENLABS_API_KEY=your-elevenlabs-key
# CARTESIA_API_KEY=your-cartesia-key

# LiveKit (for production voice agents)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ===================
# MCP Servers (Optional)
# ===================
MCP_ENABLED=false

# GitHub
GITHUB_TOKEN=your-github-personal-access-token

# Slack
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_TEAM_ID=your-slack-team-id

# Airtable
AIRTABLE_API_KEY=your-airtable-api-key

# Brave Search
BRAVE_API_KEY=your-brave-search-api-key

# Firecrawl
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Filesystem (for file operations)
LOCAL_FILE_DIR=/path/to/your/files

# ===================
# Monitoring & Observability (Optional)
# ===================
MONITORING_ENABLED=true

# Langfuse
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Prometheus
# PROMETHEUS_PORT=9090

# ===================
# Environment Settings
# ===================
ENVIRONMENT=development                      # Options: development, staging, production

# ===================
# Agent-Specific Settings (Optional)
# ===================
# Add custom settings for specific agents here
# AGENT_CODE_REVIEWER_ENABLED=true
# AGENT_SECURITY_AUDITOR_STRICT_MODE=true
# AGENT_VOICE_DEFAULT_LANGUAGE=en
